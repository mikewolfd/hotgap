# Copy to .env (gitignored). Load with:  set -a; . ./.env; set +a
# The hosted engine (engine/README.md, "Hosted on DigitalOcean"): HotGap's own
# PolicyEngine at the latest release. Without these two, the CLI uses the
# public API and its older model.
HOTGAP_PE_URL=https://hotgap-engine-ymrlt.ondigitalocean.app/us/calculate
HOTGAP_PE_TOKEN=
# Only for operating the hosted engine (creating or resizing the app, the
# registry); also stored as the DIGITALOCEAN_ACCESS_TOKEN GitHub secret that
# .github/workflows/engine-image.yml pushes images with.
DIGITAL_OCEAN_TOKEN=
