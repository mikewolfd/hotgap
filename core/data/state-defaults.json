 "sources": {
  "countyFips": {
   "what": "Most populous county (or county equivalent) in each state; DC is the District itself.",
   "publisher": "U.S. Census Bureau, Vintage 2024 county population estimates (CO-EST2024-ALLDATA), POPESTIMATE2024, SUMLEV 050.",
   "url": "https://www2.census.gov/programs-surveys/popest/datasets/2020-2024/counties/totals/co-est2024-alldata.csv",
   "index": "https://www.census.gov/data/tables/time-series/demo/popest/2020s-counties-total.html",
   "vintage": "Vintage 2024 (July 1, 2024 estimates)",
   "note": "Connecticut is reported on the nine planning regions that replaced its counties in 2022; 09110 is the Capitol Planning Region."
  },
  "monthlyRent": {
   "what": "Two-bedroom Fair Market Rent for that county, in whole dollars per month.",
   "publisher": "HUD Office of Policy Development and Research, Fair Market Rents",
   "url": "https://www.huduser.gov/portal/datasets/fmr/fmr2026/FY26_FMRs_revised.xlsx",
   "index": "https://www.huduser.gov/portal/datasets/fmr.html",
   "vintage": "FY2026 revised schedule (effective 2025-10-01)",
   "note": "The revised schedule supersedes HUD's first FY2026 file (FY26_FMRs.xlsx); the column read is the two-bedroom rent, fmr_2. In the six New England states HUD publishes FMRs by town, not by county, and a county can span two or three FMR areas. Those counties take the population-weighted mean of their town rows using HUD's own pop2023 column, rounded to the dollar: MA 25017 ($2,351/$2,941 across 54 town rows -> 2825), ME 23005 ($1,833/$2,130 across 28 town rows -> 2082), NH 33011 ($1,698/$2,037/$2,127 across 31 town rows -> 2058). CT 09110, RI 44007, VT 50007 are single-valued across their town rows. Every other state's county is one row.",
   "access": "huduser.gov answers a plain request with an empty HTTP 202 bot challenge; scripts/build-state-defaults.mjs fetches this file through a proxy."
  },
  "monthlyChildcare": {
   "what": "Price of center-based care in that same county, in whole 2026 dollars per month, for each of the NDCP's age bands: monthlyChildcareInfant (0-23 months), monthlyChildcareToddler (24-35), monthlyChildcarePreschool (36-60, not yet in school) and monthlyChildcareSchoolAge (in school; the full-time weekly rate for a school-age child, i.e. wraparound care). NDCP Technical Report, September 2024, p. 6.",
   "publisher": "U.S. Department of Labor, Women's Bureau, National Database of Childcare Prices (NDCP), variables MCInfant, MCToddler, MCPreschool, MCSA (median weekly full-time price).",
   "url": "https://www.dol.gov/sites/dolgov/files/WB/media/nationaldatabaseofchildcareprices.xlsx",
   "index": "https://www.dol.gov/agencies/wb/topics/childcare/price-by-age-care-setting",
   "vintage": "NDCP study years 2008-2018; each state's county contributes its own most recent year with a price. See childcareBasis for which year that is, state by state.",
   "arithmetic": "weekly price x 52 / 12 = monthly, then x the BLS Employment Cost Index factor from that study year to CY2026 (see eci), rounded to the dollar.",
   "fallback": "The county's own price where it has one. Where it does not, the median across the state's counties (each at its own most recent year); where the state has no center-based price in any year, the median of the 2018 cross-section (preschool: 2,360 counties, $730/month). On the state-median rule: CT. The NDCP is built on the eight pre-2022 Connecticut counties, so the Capitol Planning Region has no row of its own; Hartford County (09003), which that region largely replaces, is $1,425 on the same arithmetic against the $1,416 the state median gives. On the national-median rule, because the NDCP publishes no center-based price for them in any year: IN, NM.",
   "note": "DOL's derived 'Childcare Prices by Age of Children and Care Setting' table (Data-Table-2023.xlsx) was NOT used: for the states the NDCP leaves blank in 2018 it carries the weekly price in an annual column, giving Denver County a $36,101/year preschool price and a $693,417/year home-based price."
  }
 },
