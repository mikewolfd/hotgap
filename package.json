{
  "name": "hotgap",
  "private": true,
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "core",
    "pipeline",
    "app",
    "worker"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "npm run -s types -w worker && tsc -b core pipeline app worker",
    "contract": "RUN_CONTRACT=1 vitest run contract --no-file-parallelism",
    "pipeline": "tsx pipeline/src/run.ts",
    "hotgap": "tsx core/src/cli.ts",
    "readability": "tsx scripts/readability.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
